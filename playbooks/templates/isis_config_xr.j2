
router isis {{ isis_proc | default('CORE') }}
  net {{ isis_net }}
  is-type level-2-only
  nsr
  nsf ietf
  nsf lifetime 300
  nsf interface-timer 15
  nsf interface-expires 1
  log adjacency changes
  address-family ipv4 unicast
    metric-style wide level 2

  !
  interface Loopback0
    passive
    circuit-type level-2-only
    address-family ipv4 unicast
    !
  !
{% for intf in isis_interfaces %}
{% if intf.name != 'Loopback0' %}
  interface {{ intf.name }}
    circuit-type level-2-only
    point-to-point
    address-family ipv4 unicast
  
    !
  !
{% endif %}
{% endfor %}
!
